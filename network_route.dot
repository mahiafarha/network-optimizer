graph Network {
    layout=neato;
    node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];

    0 [label="Gateway-A", fillcolor="#A7F3D0", color="#059669", penwidth=2.5];
    1 [label="Core-1", fillcolor="#F1F5F9", color="#94A3B8"];
    2 [label="Core-2", fillcolor="#A7F3D0", color="#059669", penwidth=2.5];
    3 [label="Dist-1", fillcolor="#A7F3D0", color="#059669", penwidth=2.5];
    4 [label="Dist-2", fillcolor="#A7F3D0", color="#059669", penwidth=2.5];
    5 [label="Edge-1", fillcolor="#A7F3D0", color="#059669", penwidth=2.5];
    6 [label="Gateway-B", fillcolor="#A7F3D0", color="#059669", penwidth=2.5];

    0 -- 1 [label="4.2ms", color="#CBD5E1", penwidth=1.0];
    0 -- 2 [label="2.7ms", color="#059669", penwidth=3.0];
    1 -- 2 [label="1.5ms", color="#CBD5E1", penwidth=1.0];
    1 -- 3 [label="5ms", color="#CBD5E1", penwidth=1.0];
    2 -- 4 [label="3.8ms", color="#059669", penwidth=3.0];
    3 -- 4 [label="1.2ms", color="#059669", penwidth=3.0];
    3 -- 5 [label="2.1ms", color="#059669", penwidth=3.0];
    4 -- 5 [label="4ms", color="#CBD5E1", penwidth=1.0];
    4 -- 6 [label="6.4ms", color="#CBD5E1", penwidth=1.0];
    5 -- 6 [label="1.9ms", color="#059669", penwidth=3.0];
}
